// Charm Hyper gateway deployment contract.
//
// Capability data is NOT restated here: `GET /v1/models` publishes each row's
// context window, output cap, vision flag, effort vocabulary and per-million
// tariff, and `charmHyperModelManagerOptions` maps all of it verbatim. Only
// facts the gateway does not publish belong in this file.
provider "charm-hyper" {
	// OpenAI-dialect gateway in front of open-weight and third-party models:
	// the `developer` role and `store` are first-party OpenAI conveniences the
	// upstream engines do not implement, and the wire takes `max_tokens`.
	supports-developer-role #false
	supports-store #false
	max-tokens-field "max_tokens"
	thinking-mode "effort"
	// Reasoning arrives as `reasoning_content` on both the streamed delta and
	// the final message (verified 2026-09-11).
	reasoning-content-field "reasoning_content"
	// Per-model ladders come from the live `effort_levels` vocabulary, so the
	// discovery row already decides which models take the dial. Rows the
	// gateway leaves silent get no dial unless a rule below grants one.
	thinking-upgrade-neutral #true
	// ---------------------------------------------------------------------------
	// Residue: always-on reasoners.
	//
	// These four serve a thinking model but publish no `reasoning` block, so
	// discovery cannot see the capability. Verified live on 2026-09-11 by
	// counting `usage.completion_tokens_details.reasoning_tokens` on a prompt
	// that requires multi-step work: glm-5 387, glm-5.1 401, kimi-k2-thinking
	// 222, minimax-m2.7 568, each with `reasoning_content` populated. Every
	// other blockless row (gemma-4-26b-a4b-it, kimi-k2.5, kimi-k2.7-code,
	// llama-3.3-70b-instruct, llama-4-maverick-17b-128e-instruct-fp8,
	// qwen3-coder-480b-a35b-instruct-int4-mixed-ar, qwen3-next-80b-a3b-instruct)
	// returned zero reasoning tokens and is correctly left alone.
	//
	// The single nominal tier is what marks them as reasoning models (an exact
	// `thinking-efforts` selector upgrades a neutral target); `high` is the
	// gateway's own `default_effort_level` for every row that does publish a
	// ladder. Re-measuring effort sensitivity on these ids produced
	// non-monotonic token counts, i.e. sampling noise rather than a hidden
	// dial, so `supports-reasoning-effort` stays off and no `reasoning_effort`
	// is ever sent for them.
	// ---------------------------------------------------------------------------
	models "glm-5" "glm-5.1" "kimi-k2-thinking" "minimax-m2.7" {
		supports-reasoning-effort #false
		thinking-efforts "high"
	}
	// Residue: misreported output cap. glm-5.1 publishes
	// `max_output_tokens: 3276`, which is not a real ceiling — a single
	// completion produced 14066 tokens and still stopped on `finish_reason:
	// "stop"` rather than `length` (measured 2026-09-11). Its identically
	// sized sibling glm-5 (202752-token window) publishes 20275, the 10% the
	// gateway derives everywhere else, so 3276 is an upstream slip. Adopting
	// the sibling's value keeps long edits from truncating while staying
	// under the measured capability. Every other row's published cap is left
	// untouched.
	models "glm-5.1" {
		limits-patch {
			max-tokens 20275
		}
	}
}
